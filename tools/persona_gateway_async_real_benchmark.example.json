{
  "_README": [
    "Real-provider variant of the async Persona LLM E2E benchmark.",
    "The API key is read from AGENT_LLM_API_KEY or the ignored tools/llm_smoke_test.key file.",
    "TLS verification is disabled only for this local benchmark tool because it does not yet parse ca_bundle_path."
  ],
  "logging": {
    "log_dir": "../data/persona_gateway_async_real_benchmark/logs",
    "logger_name": "persona_gateway_async_real_benchmark",
    "file_name": "gateway.log",
    "enable_console": false,
    "use_daily_rotation": false,
    "max_file_size_bytes": 10485760,
    "max_files": 2
  },
  "persona_gateway": {
    "address": "127.0.0.1",
    "port": 18080,
    "http_io_threads": 32,
    "static_files": {"enabled": false},
    "compute_pool": {"worker_count": 2, "queue_capacity": 1024},
    "io_pool": {
      "worker_count": 4,
      "queue_capacity": 2048,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 8,
      "max_outstanding_per_fairness_key": 1024,
      "max_outstanding_per_tenant": 1024
    },
    "llm_pool": {
      "worker_count": 8,
      "queue_capacity": 2048,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 8,
      "max_outstanding_per_fairness_key": 1024,
      "max_outstanding_per_tenant": 1024
    },
    "session_idle_timeout_minutes": 15,
    "session_max_recent_turns": 8,
    "runtime_recent_raw_turns": 4,
    "runtime_default_model": "deepseek-chat",
    "personas": [
      {
        "personaId": "lidazhi",
        "personality": {
          "name": "李大志",
          "description": "你是一名正在课堂上学习的高中生，回答简洁、自然。",
          "traits": ["谨慎", "直接"],
          "openness": 0.4,
          "extraversion": 0.4,
          "humorTendency": 0.3,
          "empathyLevel": 0.6,
          "curiosityLevel": 0.3,
          "formality": 0.4
        }
      }
    ],
    "request_filter": {"enabled": true}
  },
  "gateway_auth": {
    "enabled": true,
    "allow_dev_identity": true,
    "require_auth_for_api": true,
    "enable_dev_registration": true,
    "generate_dev_keys": true,
    "issuer": "agent-benchmark",
    "audience": "agent-gateway",
    "require_session_record": false,
    "auto_provision_session": true,
    "session_store_backend": "redis",
    "redis_host": "127.0.0.1",
    "redis_port": "5000",
    "redis_pool_size": 32,
    "redis_command_timeout_ms": 5000,
    "redis_key_prefix": "agent:async-benchmark:real"
  },
  "llm": {
    "enabled": true,
    "base_url": "https://api.deepseek.com/v1",
    "async_http_io_threads": 8,
    "http_keep_alive": true,
    "http_max_idle_connections": 128,
    "http_max_idle_connections_per_origin": 128,
    "http_idle_timeout_ms": 30000,
    "api_key_env": "AGENT_LLM_API_KEY",
    "api_key_file": "llm_smoke_test.key",
    "model": "deepseek-chat",
    "timeout_ms": 120000,
    "max_retries": 1,
    "require_api_key": true,
    "disable_tls_verify_on_windows": true,
    "allow_placeholder": false
  },
  "emotion_analyzer": {"enabled": false},
  "emotion_fusion": {"enabled": false, "vector_enabled": false},
  "skill_session": {"enabled": false},
  "l0_memory": {"enabled": false},
  "local_llm": {"enabled": false}
}

{
  "_README": [
    "Reproducible configuration for the 2026-08-13 async/sync Fake A/B matrix.",
    "The original hand-written E2E parser inherited four IO workers for the LLM pool; this snapshot declares that value explicitly."
  ],
  "logging": {
    "log_dir": "../data/persona_gateway_async_benchmark_legacy/logs",
    "logger_name": "persona_gateway_async_benchmark_legacy",
    "file_name": "gateway.log",
    "enable_console": false,
    "use_daily_rotation": false,
    "max_file_size_bytes": 10485760,
    "max_files": 2
  },
  "persona_gateway": {
    "address": "127.0.0.1",
    "port": 18080,
    "http_io_threads": 8,
    "static_files": {"enabled": false},
    "compute_pool": {"worker_count": 2, "queue_capacity": 1024},
    "io_pool": {
      "worker_count": 4,
      "queue_capacity": 2048,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 8,
      "max_outstanding_per_fairness_key": 1024,
      "max_outstanding_per_tenant": 1024
    },
    "llm_pool": {
      "worker_count": 4,
      "queue_capacity": 2048,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 8,
      "max_outstanding_per_fairness_key": 1024,
      "max_outstanding_per_tenant": 1024
    },
    "session_idle_timeout_minutes": 15,
    "session_max_recent_turns": 8,
    "runtime_recent_raw_turns": 4,
    "runtime_default_model": "mock-chat",
    "personas": [
      {
        "personaId": "lidazhi",
        "personality": {
          "name": "李大志",
          "description": "你是一名正在课堂上学习的高中生，回答简洁、自然。",
          "traits": ["谨慎", "直接"]
        }
      }
    ],
    "request_filter": {"enabled": true}
  },
  "gateway_auth": {
    "enabled": true,
    "allow_dev_identity": true,
    "require_auth_for_api": true,
    "enable_dev_registration": true,
    "generate_dev_keys": true,
    "issuer": "agent-benchmark",
    "audience": "agent-gateway",
    "require_session_record": false,
    "auto_provision_session": true,
    "session_store_backend": "redis",
    "redis_host": "127.0.0.1",
    "redis_port": "5000",
    "redis_pool_size": 32,
    "redis_command_timeout_ms": 5000,
    "redis_key_prefix": "agent:async-benchmark:legacy"
  },
  "llm": {
    "enabled": true,
    "base_url": "http://127.0.0.1:18081/v1",
    "async_http_io_threads": 1,
    "http_keep_alive": false,
    "model": "mock-chat",
    "timeout_ms": 30000,
    "max_retries": 0,
    "require_api_key": false,
    "disable_tls_verify_on_windows": false,
    "allow_placeholder": false
  },
  "emotion_analyzer": {"enabled": false},
  "emotion_fusion": {"enabled": false, "vector_enabled": false},
  "skill_session": {"enabled": false},
  "l0_memory": {"enabled": false},
  "local_llm": {"enabled": false}
}
